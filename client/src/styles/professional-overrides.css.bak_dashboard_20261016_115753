  .role-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-height: 760px) and (min-width: 761px) {
  .login-box {
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
}

