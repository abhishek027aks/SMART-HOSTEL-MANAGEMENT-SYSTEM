/* SHMS HOSTEL DIRECTORY UPGRADE V1 */

/* Directory section */
.public-hostels-section {
  padding: clamp(42px, 5.5vw, 76px) 0;
  background:
    radial-gradient(ellipse at 90% 0%, rgba(224, 234, 255, 0.45), transparent 36%),
    #f5f8fd;
}

.public-hostels-section .public-hostels-inner {
  width: 100%;
  max-width: 1280px;
  margin-inline: auto;
  padding-inline: clamp(16px, 3vw, 34px);
}

.public-hostels-section .public-hostels-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 24px;
}

.public-hostels-section .public-hostels-heading h2 {
  max-width: 760px;
  margin: 5px 0 8px;
  color: #17243c;
  font-size: clamp(1.65rem, 3vw, 2.35rem);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.035em;
}

.public-hostels-section .public-hostels-heading p {
  max-width: 680px;
  color: #69778e;
  line-height: 1.65;
}

/* Search and refresh controls */
.public-hostels-section .public-hostel-search {
  position: relative;
  min-width: min(100%, 280px);
}

.public-hostels-section .public-hostel-search input {
  width: 100%;
  min-height: 48px;
  padding: 12px 15px 12px 44px;
  border: 1px solid #dce4f0;
  border-radius: 13px;
  background: #ffffff;
  color: #17243c;
  box-shadow: 0 4px 14px rgba(20, 41, 80, 0.035);
}

.public-hostels-section .public-hostel-search input:focus {
  border-color: #6c91e8;
  outline: 3px solid rgba(36, 87, 214, 0.11);
}

.public-hostels-section .public-hostel-refresh,
.public-hostels-section .public-hostel-pagination button {
  min-height: 40px;
  border: 1px solid #dce4f0;
  border-radius: 11px;
  background: #ffffff;
  color: #1c3550;
  font-weight: 700;
}

.public-hostels-section .public-hostel-refresh:hover,
.public-hostels-section .public-hostel-pagination button:hover:not(:disabled) {
  border-color: #b7c9ed;
  background: #f0f5ff;
}

/* Consistent responsive card grid */
.public-hostels-section .public-hostel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 285px), 1fr));
  align-items: stretch;
  gap: 22px;
}

.public-hostels-section .public-hostel-card {
  display: flex;
  min-width: 0;
  min-height: 100%;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #e0e7f1;
  border-radius: 19px;
  background: #ffffff;
  box-shadow: 0 7px 22px rgba(20, 41, 80, 0.055);
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.public-hostels-section .public-hostel-card:hover {
  transform: translateY(-3px);
  border-color: #c6d5f0;
  box-shadow: 0 16px 34px rgba(20, 41, 80, 0.11);
}

.public-hostels-section .public-hostel-card-media {
  position: relative;
  height: 200px;
  min-height: 200px;
  overflow: hidden;
  background: #eaf0fa;
}

.public-hostels-section .public-hostel-card-media img,
.public-hostels-section .public-hostel-card-photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.public-hostels-section .public-hostel-card-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 12px;
  padding: 18px;
}

.public-hostels-section .public-hostel-card-content h3 {
  margin: 0;
  color: #17243c;
  font-size: 1.12rem;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.public-hostels-section .public-hostel-card-location,
.public-hostels-section .public-hostel-card-address {
  color: #69778e;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.public-hostels-section .public-hostel-active-label {
  border-radius: 999px;
  font-size: 0.76rem;
  font-weight: 800;
}

/* Highlight the listed rent without inventing or changing prices */
.public-hostels-section .public-hostel-price-summary {
  padding: 12px 13px;
  border: 1px solid #e0e9fb;
  border-radius: 13px;
  background: #f4f7ff;
  color: #17243c;
}

.public-hostels-section .public-hostel-price-summary strong {
  color: #1746ad;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.public-hostels-section .public-hostel-card-stats {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.public-hostels-section .public-hostel-card-stats span {
  max-width: 100%;
  padding: 6px 9px;
  border: 1px solid #e5ebf4;
  border-radius: 9px;
  background: #f8faff;
  color: #52647d;
  font-size: 0.8rem;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.public-hostels-section .public-hostel-card-contact {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 12px;
  color: #52647d;
  font-size: 0.86rem;
}

.public-hostels-section .public-hostel-action-row-card {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: auto;
  padding-top: 4px;
}

.public-hostels-section .public-hostel-action-row-card > *,
.public-hostels-section .public-hostel-details-button {
  min-width: 0;
  border-radius: 11px;
  font-weight: 750;
}

.public-hostels-section .public-hostel-details-button {
  width: 100%;
  min-height: 43px;
  border: 1px solid #2457d6;
  background: #2457d6;
  color: #ffffff;
}

.public-hostels-section .public-hostel-details-button:hover {
  border-color: #173fa8;
  background: #173fa8;
}

/* Loading, empty and error states */
.public-hostels-section .public-hostel-state,
.public-hostels-section .public-hostel-directory-status {
  border-radius: 15px;
  line-height: 1.6;
}

.public-hostels-section .public-hostel-state {
  padding: 24px;
  border: 1px solid #e0e7f1;
  background: #ffffff;
  color: #52647d;
}

.public-hostels-section .public-hostel-error {
  border-color: #f2caca;
  background: #fff7f7;
  color: #a12626;
}

/* Hostel details popup */
.public-hostel-modal-backdrop {
  padding: 18px;
  background: rgba(9, 22, 43, 0.68);
  backdrop-filter: blur(5px);
}

.public-hostel-modal {
  width: min(760px, 100%);
  max-width: 100%;
  max-height: calc(100dvh - 36px);
  overflow-x: hidden;
  overflow-y: auto;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 21px;
  background: #ffffff;
  box-shadow: 0 25px 80px rgba(3, 16, 38, 0.3);
}

.public-hostel-modal .public-hostel-modal-content {
  padding: clamp(16px, 3vw, 26px);
}

.public-hostel-modal .public-hostel-pricing {
  border-radius: 14px;
  background: #f5f8ff;
}

.public-hostel-modal .public-hostel-pricing-item {
  border-bottom: 1px solid #e1e8f3;
}

.public-hostel-modal .public-hostel-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

/* Narrow-screen layout */
@media (max-width: 760px) {
  .public-hostels-section {
    padding: 38px 0;
  }

  .public-hostels-section .public-hostels-heading {
    align-items: stretch;
    margin-bottom: 18px;
  }

  .public-hostels-section .public-hostels-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .public-hostels-section .public-hostel-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .public-hostels-section .public-hostel-card-media {
    height: 190px;
    min-height: 190px;
  }

  .public-hostels-section .public-hostel-card-content {
    padding: 15px;
  }

  .public-hostel-modal-backdrop {
    padding: 10px;
  }

  .public-hostel-modal {
    max-height: calc(100dvh - 20px);
    border-radius: 16px;
  }
}

@media (max-width: 420px) {
  .public-hostels-section .public-hostel-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .public-hostels-section .public-hostel-card {
    transition: none;
  }

  .public-hostels-section .public-hostel-card:hover {
    transform: none;
  }
}
