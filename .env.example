# Smart Hostel Management System
# Environment variable template only.
# Do not place real secrets in this file.

NODE_ENV=development
PORT=5000
JSON_BODY_LIMIT=1mb
MONGODB_URI=mongodb://127.0.0.1:27017/smart_hostel_management?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:5000

# Generate a random secret with at least 32 bytes; never commit the value.
JWT_SECRET=
