import { useCallback, useEffect, useState } from "react";
import { Bell, Plus, RefreshCw } from "lucide-react";
import { apiRequest } from "../services/api.js";

const label = (value) => String(value || "").replaceAll("_", " ").toLowerCase().replace(/^./, (letter) => letter.toUpperCase());
const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "";

export default function NoticesPage({ token, role }) {
  const canPublish = ["OWNER", "WARDEN", "SYSTEM_ADMIN"].includes(role);
  const [items, setItems] = useState([]); const [loading, setLoading] = useState(true); const [error, setError] = useState(""); const [notice, setNotice] = useState(""); const [reload, setReload] = useState(0); const [busy, setBusy] = useState(false);
  const [form, setForm] = useState({ title: "", body: "", target: "ALL", priority: "GENERAL" });
  const load = useCallback(async (signal) => { setLoading(true); setError(""); try { const response = await apiRequest(canPublish ? "/api/notices" : "/api/notices/mine", { token, signal }); setItems(Array.isArray(response?.data?.items) ? response.data.items : []); } catch (requestError) { if (requestError.name !== "AbortError") setError(requestError.message || "Unable to load notices."); } finally { if (!signal.aborted) setLoading(false); } }, [canPublish, token]);
  useEffect(() => { const controller = new AbortController(); void load(controller.signal); return () => controller.abort(); }, [load, reload]);
  const publish = async (event) => { event.preventDefault(); setBusy(true); setError(""); setNotice(""); try { await apiRequest("/api/notices", { token, method: "POST", body: JSON.stringify(form) }); setForm({ title: "", body: "", target: "ALL", priority: "GENERAL" }); setNotice("Notice published."); setReload((value) => value + 1); } catch (requestError) { setError(requestError.message || "Unable to publish notice."); } finally { setBusy(false); } };
  return <section className="notices-module" aria-labelledby="notices-heading"><header className="complaint-heading"><span className="complaint-heading-icon"><Bell size={24} aria-hidden="true" /></span><div><span className="dashboard-kicker">HOSTEL UPDATES</span><h2 id="notices-heading">Notices</h2><p>{canPublish ? "Publish live notices to your verified hostel audience." : "Notices published for your hostel account."}</p></div><button className="facility-secondary" type="button" onClick={() => setReload((value) => value + 1)} disabled={loading}><RefreshCw size={16} aria-hidden="true" />Refresh</button></header>
  {canPublish ? <form className="complaint-form" onSubmit={publish}><div className="complaint-section-title"><div><span>PUBLISH NOTICE</span><h3>Hostel communication</h3></div><Plus size={21} aria-hidden="true" /></div><div className="complaint-form-grid"><label className="complaint-field complaint-field-wide">Title<input required minLength="3" maxLength="160" value={form.title} onChange={(e) => setForm({ ...form, title: e.target.value })} /></label><label className="complaint-field">Audience<select value={form.target} onChange={(e) => setForm({ ...form, target: e.target.value })}><option value="ALL">Everyone in hostel</option><option value="ALL_STUDENTS">All students</option><option value="ALL_PARENTS">All parents</option></select></label><label className="complaint-field">Priority<select value={form.priority} onChange={(e) => setForm({ ...form, priority: e.target.value })}><option value="GENERAL">General</option><option value="IMPORTANT">Important</option><option value="URGENT">Urgent</option></select></label><label className="complaint-field complaint-field-wide">Message<textarea required minLength="5" maxLength="4000" rows="4" value={form.body} onChange={(e) => setForm({ ...form, body: e.target.value })} /></label></div><button className="facility-primary" disabled={busy} type="submit"><Plus size={16} aria-hidden="true" />{busy ? "Publishing..." : "Publish notice"}</button></form> : null}
  {error ? <p className="facility-error" role="alert">{error}</p> : null}{notice ? <p className="facility-notice" role="status">{notice}</p> : null}{loading ? <div className="complaint-state" role="status">Loading notices...</div> : null}{!loading && !error && items.length === 0 ? <div className="complaint-state"><Bell size={25} aria-hidden="true" /><strong>No notices found</strong><span>New hostel notices will appear here.</span></div> : null}
  <div className="notice-grid">{items.map((item) => <article className="notice-card" key={item._id}><span className={`notice-tag ${String(item.priority || "").toLowerCase()}`}>{label(item.priority)}</span><h3>{item.title}</h3><p>{item.body}</p><footer><span>{label(item.target)}</span><time>{formatDate(item.createdAt)}</time></footer></article>)}</div></section>;
}
